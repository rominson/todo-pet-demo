/* custom-tab-bar —— 自定义 tabBar
   固定底部、自身撑满安全区（env(safe-area-inset-bottom)），颜色对齐原生 tabBar 配置：
   未选中 #8a847b、选中 #7e6fd6、底 #faf8f4。
   注意：custom = true 时框架不再为页面预留 tabBar 高度，所以各 tab 页要自己留底部内边距。 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  height: 100rpx;
  box-sizing: content-box;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #FAF8F4;
  border-top: 1rpx solid #EEE9E1;
}
.tb {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tb-ico { width: 48rpx; height: 48rpx; }
.tb-txt { font-size: 20rpx; color: #8a847b; margin-top: 2rpx; }
.tb.on .tb-txt { color: #7e6fd6; }
