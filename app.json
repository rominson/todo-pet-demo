      { "pagePath": "pages/quadrant/quadrant", "text": "象限", "iconPath": "assets/tab/quad.png", "selectedIconPath": "assets/tab/quad-active.png" },
      { "pagePath": "pages/calendar/calendar", "text": "日历", "iconPath": "assets/tab/calendar.png", "selectedIconPath": "assets/tab/calendar-active.png" },
      { "pagePath": "pages/pets/pets", "text": "遇见", "iconPath": "assets/tab/meet.png", "selectedIconPath": "assets/tab/meet-active.png" }
    ]
  },
  "usingComponents": {
    "custom-tab-bar": "custom-tab-bar/index"
