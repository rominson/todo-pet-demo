/* app.wxss —— 全局样式（精确对齐 prototype/index.html 设计 token） */
page {
  /* 设计 token（提取自 prototype/index.html :root，1:1 对齐） */
  --bg: #F6F4EF;           /* 米白页面底 */
  --bg-soft: #FBF9F4;      /* 更浅面板（弹层用） */
  --card: #FFFFFF;         /* 白卡片 */
  --ink: #2D2A26;          /* 主文字（近黑） */
  --ink-2: #8A847B;        /* 次级文字 */
  --ink-3: #B8B2A8;        /* 弱化文字/描边 */
  --accent: #A898FA;       /* 浅紫：按钮/选中（原型 --accent） */
  --accent-d: #7E6FD6;     /* 深紫：文字/边框（原型 --accent-d） */
  --accent-soft: #ECE8FD;  /* 浅紫底（原型 --accent-l） */
  --accent-2: #A898FA;     /* 亮紫（兼容旧引用） */
  --gold: #E8B54C;         /* 金色：价格药丸（原型 --gold） */
  --gold-l: #FBF0D6;       /* 浅金底 */
  --warm: #E8892F;         /* 暖橙（逾期点缀） */
  --warm-soft: #FCE7D3;    /* 浅橙底 */
  --track: #EFEBE3;        /* 进度条轨道 / 模式条底 */
  --ok: #7FB77E;           /* 完成绿 */
  --line: #EEE9E1;         /* 分隔线 */
  --radius: 36rpx;         /* 18px 卡片圆角 */
  --shadow: 0 4rpx 24rpx rgba(60, 50, 40, 0.05);
  --serif: "Songti SC", "Noto Serif SC", "STSong", serif;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 40rpx;
  box-shadow: var(--shadow);
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin: 40rpx 8rpx 20rpx;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx 0;
  text-align: center;
  font-weight: 600;
}

.btn-ghost {
  background: transparent;
  color: var(--ink-2);
  border-radius: 999rpx;
  padding: 24rpx 0;
  text-align: center;
  border: 2rpx solid var(--ink-3);
}

.muted { color: var(--ink-2); }
.center { text-align: center; }

/* ============ 待办左滑操作（对齐原型 .task-swipe / .swipe-btn）============
   原型里待办没有右侧的叉：左滑露出「删除」。容器负责裁剪，item 负责背景遮罩。 */
.task-swipe {
  position: relative;
  overflow: hidden;
}
.swipe-btn {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  z-index: 1;
  /* 关键：没左滑时必须彻底不可见。
     行在完成态/未来态上有 opacity（原型 .task-item.done{opacity:.55}、.q-task.future{opacity:.75}），
     若按钮只是「被行盖住」，半透明的行会把红色按钮透出来 —— 所以显隐只能由 .open 控制。 */
  opacity: 0;
  pointer-events: none;
  transition: opacity .18s ease;
}
.swipe-btn.del { background: #D95B5B; }
.swipe-btn.skip { background: #8BA3C7; }
.task-swipe.open .swipe-btn { opacity: 1; pointer-events: auto; }

/* ============ 完成勾选：几何对勾 ============
   不用「✓」字体符号（字重与整体风格不搭、偏俏皮），改用描边画出的正规对勾。 */
.tick {
  width: 20rpx;
  height: 11rpx;
  margin-top: -5rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg);
  opacity: 0;
  transition: opacity .2s;
}
.check.on .tick { opacity: 1; }

/* ============ 宠物「档案」小按钮（对齐原型 .pet-archive-pop）============
   点头像弹出/收起，点它进档案页——不是跳聊天页（原型没有聊天）。 */
.pet-archive-pop {
  position: absolute;
  top: 50%;
  z-index: 8;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: var(--accent-d);
  border-radius: 28rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(126, 111, 214, 0.35);
  opacity: 0;
  transform: translateY(-50%) scale(0.85);
  pointer-events: none;
  transition: opacity .22s, transform .22s;
}
.pet-archive-pop.show {
  opacity: 1;
  transform: translateY(-50%) scale(1);
  pointer-events: auto;
}

/* 弹层提交按钮：与上方表单拉开距离（原来贴着表单太近） */
.modal .btn-primary { margin-top: 32rpx; }

/* 弹层里的「已在使用」按钮（遇见页「陪伴中」）：淡紫不可点。
   用 view + 类名而不是 button[disabled]，避免被小程序内置 disabled 样式盖掉。 */
.btn-primary.is-disabled {
  background: #CFC8E8;
  color: #fff;
  pointer-events: none;
}

/* 通用底部弹层
   注意：自定义 tabBar（custom:true）的层级由框架控制，高于页面内任何 z-index，
   弹层压不住它。所以遮罩主动让出 tabBar 那条高度（100rpx + 安全区），
   弹层整体落在 tabBar 之上，内容不会被切掉。 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: rgba(45, 42, 38, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.modal {
  width: 100%;
  position: relative; /* 右上角关闭叉 .sheet-x 的绝对定位基准 */
  background: var(--bg-soft);
  border-radius: 48rpx;
  padding: 44rpx 40rpx 44rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}

/* 通用表单 */
.input {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 30rpx;
}

/* 弹层右上角关闭叉（对齐原型 .sheet-x）：点叉或点遮罩关闭，不再放「取消」按钮 */
.sheet-x {
  position: absolute;
  right: 32rpx;
  top: 30rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0,0,0,.05);
  color: var(--ink-2);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
/* 重复频率（对齐原型 .freq-pick / #freq-custom） */
.freq-row { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.freq-opt {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 18rpx;
  background: #F1EDE5;
  color: var(--ink-2);
  font-size: 25rpx;
  font-weight: 600;
}
.freq-opt.on { background: var(--accent); color: #fff; }
.custom-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.custom-lbl { font-size: 26rpx; color: var(--ink-2); }
.custom-num {
  width: 110rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: var(--card);
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
.custom-unit {
  padding: 14rpx 22rpx;
  border-radius: 16rpx;
  background: var(--card);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
