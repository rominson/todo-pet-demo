/* app.wxss —— 全局样式（精确对齐 prototype/index.html 设计 token） */
page {
  /* 设计 token（提取自 prototype/index.html :root，1:1 对齐） */
  --bg: #F6F4EF;           /* 米白页面底 */
  --bg-soft: #FBF9F4;      /* 更浅面板（弹层用） */
  --card: #FFFFFF;         /* 白卡片 */
  --ink: #2D2A26;          /* 主文字（近黑） */
  --ink-2: #8A847B;        /* 次级文字 */
  --ink-3: #B8B2A8;        /* 弱化文字/描边 */
  --accent: #A898FA;       /* 浅紫：按钮/选中（原型 --accent） */
  --accent-d: #7E6FD6;     /* 深紫：文字/边框（原型 --accent-d） */
  --accent-soft: #ECE8FD;  /* 浅紫底（原型 --accent-l） */
  --accent-2: #A898FA;     /* 亮紫（兼容旧引用） */
  --gold: #E8B54C;         /* 金色：价格药丸（原型 --gold） */
  --gold-l: #FBF0D6;       /* 浅金底 */
  --warm: #E8892F;         /* 暖橙（逾期点缀） */
  --warm-soft: #FCE7D3;    /* 浅橙底 */
  --track: #EFEBE3;        /* 进度条轨道 / 模式条底 */
  --ok: #7FB77E;           /* 完成绿 */
  --line: #EEE9E1;         /* 分隔线 */
  --radius: 36rpx;         /* 18px 卡片圆角 */
  --shadow: 0 4rpx 24rpx rgba(60, 50, 40, 0.05);
  --serif: "Songti SC", "Noto Serif SC", "STSong", serif;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 40rpx;
  box-shadow: var(--shadow);
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin: 40rpx 8rpx 20rpx;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx 0;
  text-align: center;
  font-weight: 600;
}

.btn-ghost {
  background: transparent;
  color: var(--ink-2);
  border-radius: 999rpx;
  padding: 24rpx 0;
  text-align: center;
  border: 2rpx solid var(--ink-3);
}

.muted { color: var(--ink-2); }
.center { text-align: center; }

/* 通用底部弹层 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(45, 42, 38, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.modal {
  width: 100%;
  position: relative; /* 右上角关闭叉 .sheet-x 的绝对定位基准 */
  background: var(--bg-soft);
  border-radius: 48rpx 48rpx 0 0;
  padding: 44rpx 40rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}

/* 通用表单 */
.input {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 30rpx;
}

/* 弹层右上角关闭叉（对齐原型 .sheet-x）：点叉或点遮罩关闭，不再放「取消」按钮 */
.sheet-x {
  position: absolute;
  right: 32rpx;
  top: 30rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0,0,0,.05);
  color: var(--ink-2);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
/* 重复频率（对齐原型 .freq-pick / #freq-custom） */
.freq-row { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.freq-opt {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 18rpx;
  background: #F1EDE5;
  color: var(--ink-2);
  font-size: 25rpx;
  font-weight: 600;
}
.freq-opt.on { background: var(--accent); color: #fff; }
.custom-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.custom-lbl { font-size: 26rpx; color: var(--ink-2); }
.custom-num {
  width: 110rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: var(--card);
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
.custom-unit {
  padding: 14rpx 22rpx;
  border-radius: 16rpx;
  background: var(--card);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
