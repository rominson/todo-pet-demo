/* app.wxss —— 全局样式（对齐原型：米白底 / 白卡片 / 紫色主色 / 暖棕文字） */
page {
  /* 设计 token（提取自 prototype/index.html） */
  --bg: #f1ede5;          /* 米白页面底 */
  --bg-soft: #faf8f4;     /* 更浅面板 */
  --card: #ffffff;        /* 白卡片 */
  --ink: #3a2e10;         /* 暖棕主文字 */
  --ink-2: #8a847b;       /* 次级文字 */
  --ink-3: #c9c2b6;       /* 弱化文字/描边 */
  --accent: #7e6fd6;      /* 紫色主色 */
  --accent-soft: #ece8fd; /* 浅紫底 */
  --accent-2: #a898fa;    /* 亮紫 */
  --warm: #e8892f;        /* 暖橙（逾期/价格点缀） */
  --warm-soft: #fce7d3;   /* 浅橙底 */
  --track: #efebe3;       /* 进度条轨道 */
  --ok: #7fb77e;          /* 完成绿 */
  --serif: Georgia, "Times New Roman", "STSongti-SC", "SimSun", serif;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  background: var(--card);
  border-radius: 44rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(58, 46, 16, 0.05);
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin: 40rpx 8rpx 20rpx;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx 0;
  text-align: center;
  font-weight: 600;
}

.btn-ghost {
  background: transparent;
  color: var(--ink-2);
  border-radius: 999rpx;
  padding: 24rpx 0;
  text-align: center;
  border: 2rpx solid var(--ink-3);
}

.muted { color: var(--ink-2); }
.center { text-align: center; }

/* 通用底部弹层 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(58, 46, 16, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.modal {
  width: 100%;
  background: var(--bg-soft);
  border-radius: 48rpx 48rpx 0 0;
  padding: 44rpx 40rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}

/* 通用表单 */
.input {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 30rpx;
}
