/* app.wxss —— 全局样式（简约温暖调性，呼应原型） */
page {
  --brand: #ff8a3d;
  --brand-soft: #ffe9d6;
  --ink: #2b2b2b;
  --ink-soft: #8a8a8a;
  --bg: #f7f5f2;
  --card: #ffffff;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: var(--brand);
  color: #fff;
  border-radius: 999rpx;
  padding: 20rpx 0;
  text-align: center;
  font-weight: 600;
}

.muted { color: var(--ink-soft); }
.center { text-align: center; }
