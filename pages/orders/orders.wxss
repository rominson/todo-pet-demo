/* pages/orders/orders.wxss —— 订单中心页（米白底 + 白卡，与日历/今日页同一套 token） */
.page { padding: 28rpx 36rpx 60rpx; box-sizing: border-box; }

.hd { margin: 8rpx 8rpx 22rpx; }
.hd-title { font-family: var(--serif); font-size: 40rpx; font-weight: 800; color: var(--ink); }
.hd-sub { font-size: 24rpx; color: var(--ink-2); margin-top: 8rpx; }

.card { background: var(--card); border-radius: 24rpx; box-shadow: var(--shadow); }
.sum { font-size: 23rpx; color: var(--ink-2); margin: 0 8rpx 18rpx; }

.od { padding: 26rpx 28rpx; margin-bottom: 20rpx; }
.od-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.od-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.od-amt { font-family: var(--serif); font-size: 32rpx; font-weight: 800; color: var(--accent-d); flex: none; }
.od-desc { font-size: 23rpx; color: var(--ink-2); margin-top: 8rpx; }
.od-bot { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.od-time { font-size: 22rpx; color: var(--ink-3); }
.od-status { font-size: 21rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.od-status.paid { color: #4F8A4E; background: rgba(127, 183, 126, 0.16); }
.od-status.unpaid { color: var(--ink-2); background: #F1EFE8; }
.od-id {
  font-size: 21rpx; color: var(--ink-3); margin-top: 14rpx; padding-top: 14rpx;
  border-top: 2rpx dashed var(--line);
}

.state { padding: 56rpx 32rpx; text-align: center; }
.state-t { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.state-s { font-size: 24rpx; color: var(--ink-2); margin-top: 10rpx; line-height: 1.6; }
.btn {
  display: inline-block; margin-top: 26rpx; padding: 16rpx 42rpx;
  border-radius: 999rpx; background: var(--accent); color: #fff; font-size: 26rpx;
}

.foot { font-size: 21rpx; color: var(--ink-3); text-align: center; margin-top: 26rpx; line-height: 1.6; }
