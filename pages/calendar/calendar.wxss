/* pages/calendar/calendar.wxss */
.page { padding: 24rpx 28rpx 60rpx; }
.title { font-family: var(--serif); font-size: 44rpx; font-weight: 600; margin: 8rpx 8rpx 24rpx; }

.cal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.month { font-size: 30rpx; font-weight: 600; }
.nav {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg);
  color: var(--ink-2);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav.off { color: var(--ink-3); }

.cal-week { display: flex; margin-bottom: 8rpx; }
.cal-week text { flex: 1; text-align: center; color: var(--ink-2); font-size: 24rpx; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: calc(100% / 7);
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.cal-day { font-size: 24rpx; color: var(--ink-2); }
.cal-paw { width: 44rpx; height: 44rpx; }
.cal-cell.milestone {
  background: var(--accent-soft);
  border-radius: 20rpx;
}
.cal-legend { text-align: center; color: var(--ink-2); font-size: 24rpx; margin-top: 20rpx; }
