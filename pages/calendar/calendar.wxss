/* pages/calendar/calendar.wxss —— 对齐原型 screen-footprint */
/* 底部留出自定义 tabBar（100rpx + 安全区）的高度，内容不被盖住 */
.page {
  padding: 28rpx 36rpx 160rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.title { font-family: var(--serif); font-size: 40rpx; font-weight: 800; color: var(--ink); margin: 8rpx 8rpx 24rpx; }

.cal { padding: 28rpx 24rpx; margin-bottom: 24rpx; }
.cal-head { display: flex; align-items: center; justify-content: space-between; margin: 4rpx 4rpx 20rpx; }
.cal-head .month { font-family: var(--serif); font-size: 36rpx; font-weight: 800; color: var(--ink); }
.nav {
  width: 64rpx; height: 64rpx; border-radius: 20rpx; background: var(--card); box-shadow: var(--shadow);
  color: var(--ink-2); display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.nav.off { opacity: .35; }

.cal-week { display: grid; grid-template-columns: repeat(7,1fr); gap: 8rpx; font-size: 22rpx; color: var(--ink-3); font-weight: 700; text-align: center; margin: 8rpx 0; }
.cal-grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 8rpx; }
.cal-cell {
  aspect-ratio: 1; border-radius: 12rpx; background: var(--card); box-shadow: var(--shadow);
  position: relative; display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: var(--ink-2);
}
.cal-cell.empty { background: transparent; box-shadow: none; }
.cal-cell.today, .cal-cell.selected { outline: 3rpx solid var(--accent); outline-offset: -3rpx; }

/* 日期数字：右上角小号（对齐原型 .cal-cell .num），白色描边保证压到头像上也能看清 */
.num {
  position: absolute; top: 6rpx; right: 10rpx; z-index: 4;
  font-size: 20rpx; color: var(--ink-3);
  text-shadow: 0 0 3rpx #fff, 0 0 6rpx #fff, 0 0 9rpx #fff;
}

/* 足迹头像堆：整块绝对定位 + overflow 裁剪，每个头像用内联 style 定 left/top/rotate。
   数量不设上限——超过 9 个会绕回锚点，并因抖动偏移而互相叠压（原型 petGlyphs 行为）。 */
.glyph-stack {
  position: absolute; top: 6rpx; right: 4rpx; bottom: 24rpx; left: 4rpx;
  overflow: hidden; z-index: 3; pointer-events: none;
}
.glyph-pet { position: absolute; width: 26rpx; height: 26rpx; opacity: .95; }

/* 待办点：一个点 = 一件待办；未完成紫、已完成灰（对齐原型 .task-dots） */
.task-dots {
  position: absolute; bottom: 10rpx; left: 50%; transform: translateX(-50%);
  width: 76rpx; display: flex; flex-wrap: wrap; justify-content: center; gap: 5rpx; z-index: 2;
}
.task-dots .td { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--accent); }
.task-dots .td.done { background: #C9C2B6; }

.detail { padding: 28rpx 28rpx 32rpx; margin-bottom: 24rpx; }
.dd-title { font-weight: 700; color: var(--ink); margin-bottom: 12rpx; font-size: 28rpx; }
.dd-sec {
  font-size: 24rpx; color: var(--ink-3); font-weight: 600;
  margin: 18rpx 0 4rpx; letter-spacing: 1rpx;
}
.dd-sec:first-of-type { margin-top: 4rpx; }
/* 当天安排：小圆圈只反映状态（不可点，去今日/象限页勾选），完成则划线 */
.dd-row { display: flex; align-items: flex-start; gap: 14rpx; padding: 14rpx 0; border-top: 1rpx dashed var(--line); }
.dd-dot {
  width: 30rpx; height: 30rpx; border-radius: 50%; flex: none; margin-top: 4rpx;
  border: 2rpx solid var(--line); background: #fff;
}
.dd-dot.on {
  border-color: var(--ok); background: var(--ok);
  position: relative;
}
.dd-dot.on::after {
  content: ''; position: absolute; left: 9rpx; top: 4rpx;
  width: 8rpx; height: 15rpx; border: solid #fff; border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}
.dd-dot.ses { border-color: var(--accent); background: var(--accent-soft); }
.dd-text { flex: 1; min-width: 0; }
.dd-t { font-size: 26rpx; color: var(--ink-2); line-height: 1.45; }
.dd-m { font-size: 22rpx; color: var(--ink-3); margin-top: 4rpx; }
.dd-row.done .dd-t { text-decoration: line-through; color: var(--ink-3); }
.dd-empty { color: var(--ink-3); font-size: 26rpx; }

.partners { display: flex; align-items: center; padding: 28rpx; }
.p-title { font-family: var(--serif); font-size: 30rpx; font-weight: 800; color: var(--ink); }
.p-sub { font-size: 24rpx; color: var(--ink-2); margin-top: 6rpx; }
