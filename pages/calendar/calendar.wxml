<!-- pages/calendar/calendar.wxml —— 对齐原型 screen-footprint -->
<view class="page">
  <view class="title">日历 · 我的坚持之墙</view>

  <view class="card cal">
    <view class="cal-head">
      <view class="nav" bindtap="prev">‹</view>
      <view class="month">{{year}}年{{month}}月</view>
      <view class="nav {{canGoNext?'':'off'}}" bindtap="next">›</view>
    </view>
    <view class="cal-week">
      <text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text>
    </view>
    <view class="cal-grid">
      <view wx:for="{{cells}}" wx:key="index" wx:for-index="index"
            class="cal-cell {{item.empty?'empty':''}} {{item.today&&!item.sel?'today':''}} {{item.sel?'selected':''}}"
            bindtap="selectCell" data-d="{{item.day}}">
        <text wx:if="{{!item.empty}}" class="cal-day {{item.has?'mini':''}}">{{item.day}}</text>
        <view wx:if="{{item.has}}" class="cal-pets">
          <image wx:for="{{item.pets}}" wx:for-item="p" wx:key="k" class="cal-pet {{item.size}}" src="{{p.img}}" mode="aspectFit"/>
        </view>
      </view>
    </view>
  </view>

  <view class="card detail">
    <view class="dd-title">{{dayLabel || '今天'}} · 当天安排</view>
    <block wx:if="{{dayDetail.length}}">
      <view wx:for="{{dayDetail}}" wx:key="i" class="dd-row">{{item}}</view>
    </block>
    <view wx:else class="dd-empty">这一天还没有记录</view>
  </view>
</view>
