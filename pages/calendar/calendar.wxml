<!-- pages/calendar/calendar.wxml —— 对齐原型 screen-footprint -->
<view class="page">
  <view class="title">日历 · 我的坚持之墙</view>

  <view class="card cal">
    <view class="cal-head">
      <view class="nav" bindtap="prev">‹</view>
      <view class="month">{{year}}年{{month}}月</view>
      <view class="nav {{canGoNext?'':'off'}}" bindtap="next">›</view>
    </view>
    <view class="cal-week">
      <text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text>
    </view>
    <view class="cal-grid">
      <view wx:for="{{cells}}" wx:key="index" wx:for-index="index"
            class="cal-cell {{item.empty?'empty':''}} {{item.today&&!item.sel?'today':''}} {{item.sel?'selected':''}}"
            bindtap="selectCell" data-d="{{item.day}}">
        <text wx:if="{{!item.empty}}" class="cal-day {{item.has?'mini':''}}">{{item.day}}</text>
        <view wx:if="{{item.has}}" class="cal-pets">
          <image wx:for="{{item.pets}}" wx:for-item="p" wx:key="k" class="cal-pet {{item.size}}" src="{{p.img}}" mode="aspectFit"/>
        </view>
      </view>
    </view>
  </view>

  <view class="card detail">
    <view class="dd-title">{{dayLabel || '今天'}}</view>

    <block wx:if="{{dayTasks.length}}">
      <view class="dd-sec">当天安排</view>
      <view wx:for="{{dayTasks}}" wx:key="_id" class="dd-row {{item.done?'done':''}}">
        <view class="dd-dot {{item.done?'on':''}}"></view>
        <view class="dd-text">
          <view class="dd-t">{{item.title}}</view>
          <view wx:if="{{item.repeatLabel}}" class="dd-m">🔁 {{item.repeatLabel}}</view>
        </view>
      </view>
    </block>

    <block wx:if="{{daySessions.length}}">
      <view class="dd-sec">当天足迹</view>
      <view wx:for="{{daySessions}}" wx:key="i" class="dd-row">
        <view class="dd-dot ses"></view>
        <view class="dd-text">
          <view class="dd-t">{{item.text}}</view>
        </view>
      </view>
    </block>

    <view wx:if="{{!dayTasks.length && !daySessions.length}}" class="dd-empty">这天还没有安排，也没关系。</view>
  </view>
</view>
