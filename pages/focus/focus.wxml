<!-- pages/focus/focus.wxml —— 对齐原型 screen-focus（无日历，宠物角落小图） -->
<scroll-view scroll-y class="page" enhanced show-scrollbar="{{false}}">
  <!-- 模式切换：内联药丸 -->
  <view class="focus-mode-switch">
    <view class="fm {{mode==='focus'?'on':''}}" bindtap="switchMode" data-mode="focus">专注 25'</view>
    <view class="fm {{mode==='meditate'?'on':''}}" bindtap="switchMode" data-mode="meditate">冥想 15'</view>
  </view>

  <!-- 主卡：宠物小图 + 状态文案 + 计时器 + 按钮 -->
  <view class="focus-card">
    <view class="focus-stage">
      <image class="pet-corner {{sceneLive ? 'live' : ''}}" src="{{sceneSrc}}" mode="aspectFit" />
      <view class="timer-sub">{{sub}}</view>
    </view>
    <view class="timer {{running?'running':''}}">{{timeText}}</view>
    <button class="btn-primary big" bindtap="start">{{running ? '结束' : '开始专注'}}</button>
    <button wx:if="{{running}}" class="btn-ghost fast" bindtap="fastForward">快进（演示）</button>
  </view>

  <view class="focus-hint">中途停下来也没关系——{{pet.name}}不会怪你，下次想专注了，它随时都在。</view>
</scroll-view>
