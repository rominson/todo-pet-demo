/* pages/focus/focus.wxss —— 对齐原型 screen-focus */
.page { height: 100vh; box-sizing: border-box; padding: 28rpx 36rpx 80rpx; }

/* 模式切换药丸 */
.focus-mode-switch {
  display: flex; background: var(--track); border-radius: 28rpx;
  padding: 8rpx; margin: 8rpx 0 24rpx;
}
.fm {
  flex: 1; text-align: center; padding: 18rpx; border-radius: 22rpx;
  font-size: 27rpx; font-weight: 700; color: var(--ink-2);
}
.fm.on { background: #fff; color: var(--ink); box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }

.sub { font-size: 26rpx; color: var(--ink-2); text-align: center; margin-bottom: 8rpx; }

/* 宠物舞台 */
.focus-stage { text-align: center; padding: 16rpx 0 8rpx; }
.pet-scene { width: 320rpx; height: 200rpx; }

/* 计时器 */
.timer {
  font-family: var(--serif);
  font-size: 120rpx; font-weight: 800; letter-spacing: 4rpx;
  text-align: center; margin: 36rpx 0 8rpx;
  font-variant-numeric: tabular-nums; color: var(--ink);
}
.timer.running { color: var(--accent-d); }
.timer-sub { font-size: 26rpx; color: var(--ink-2); text-align: center; min-height: 40rpx; margin-bottom: 12rpx; }

.btn-primary.big { width: 100%; padding: 30rpx 0; font-size: 32rpx; margin-top: 4rpx; }
.fast { text-align: center; font-size: 24rpx; color: var(--ink-3); margin-top: 20rpx; }

.reassure {
  font-size: 26rpx; color: var(--ink-2); text-align: center;
  line-height: 1.7; margin: 36rpx 40rpx 8rpx;
}

/* 我的坚持之墙 */
.wall { margin-top: 40rpx; padding: 32rpx 28rpx; }
.wall-head { font-size: 30rpx; font-weight: 700; color: var(--ink); margin-bottom: 20rpx; }
.cal-week { display: grid; grid-template-columns: repeat(7,1fr); gap: 8rpx; font-size: 22rpx; color: var(--ink-3); font-weight: 700; text-align: center; margin: 8rpx 0; }
.cal-grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 8rpx; }
.cal-cell {
  aspect-ratio: 1; border-radius: 12rpx; background: var(--card); box-shadow: var(--shadow);
  display: flex; align-items: center; justify-content: center; position: relative;
  font-size: 24rpx; color: var(--ink-2);
}
.cal-cell.empty { background: transparent; box-shadow: none; }
.cal-cell.today, .cal-cell.selected { outline: 3rpx solid var(--accent); outline-offset: -3rpx; }
.cdot { position: absolute; bottom: 10rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--accent); }
.day-detail { margin-top: 28rpx; font-size: 26rpx; line-height: 1.7; }
.dd-title { font-weight: 700; color: var(--ink); margin-bottom: 8rpx; }
.dd-row { padding: 8rpx 0; color: var(--ink-2); border-top: 1rpx dashed var(--line); }
.dd-empty { color: var(--ink-3); }

.bubble {
  margin: 32rpx 12rpx 0; padding: 24rpx 28rpx; background: var(--accent-soft);
  border-radius: 28rpx; font-size: 28rpx; color: var(--accent-d); line-height: 1.6;
}
