/* pages/focus/focus.wxss */
.page { padding: 60rpx 40rpx; display: flex; flex-direction: column; align-items: center; }

.stage { display: flex; flex-direction: column; align-items: center; margin: 60rpx 0 40rpx; }
.pet-ava {
  width: 200rpx; height: 200rpx; border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 110rpx; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.12);
}
.pet-ava.anim { animation: breathe 3.2s ease-in-out infinite; }
@keyframes breathe { 0%,100%{ transform: scale(1);} 50%{ transform: scale(1.05);} }

.ctx {
  margin-top: 24rpx; font-size: 24rpx; color: var(--brand);
  background: var(--brand-soft); padding: 6rpx 20rpx; border-radius: 999rpx;
}
.timer {
  font-size: 120rpx; font-weight: 800; letter-spacing: 4rpx;
  margin-top: 40rpx; font-variant-numeric: tabular-nums;
  color: var(--ink);
}
.timer.running { color: var(--brand); }
.sub { font-size: 26rpx; color: var(--ink-soft); margin-top: 12rpx; text-align: center; }

.mode-switch {
  display: flex; gap: 0; background: #efefef; border-radius: 999rpx;
  padding: 6rpx; margin: 40rpx 0;
}
.mode {
  padding: 18rpx 56rpx; border-radius: 999rpx;
  font-size: 28rpx; color: var(--ink-soft);
}
.mode.on { background: #fff; color: var(--brand); font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08); }
.mode-switch.locked { opacity: 0.5; pointer-events: none; }

.btn-primary.big { width: 100%; padding: 30rpx 0; font-size: 32rpx; margin-top: 20rpx; }
.cancel { margin-top: 24rpx; font-size: 26rpx; color: var(--ink-soft); }

.bubble {
  position: fixed; left: 40rpx; right: 40rpx; bottom: 60rpx;
  background: var(--ink); color: #fff; font-size: 28rpx; line-height: 1.5;
  padding: 24rpx 30rpx; border-radius: 24rpx; box-shadow: 0 12rpx 36rpx rgba(0,0,0,0.25);
}
