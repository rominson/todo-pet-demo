/* pages/focus/focus.wxss —— 对齐原型 screen-focus（无日历） */
.page { height: 100vh; box-sizing: border-box; padding: 28rpx 36rpx 80rpx; }

/* 模式切换药丸 */
.focus-mode-switch {
  display: flex; background: var(--track); border-radius: 28rpx;
  padding: 8rpx; margin: 8rpx 0 0;
}
.fm {
  flex: 1; text-align: center; padding: 18rpx; border-radius: 22rpx;
  font-size: 27rpx; font-weight: 700; color: var(--ink-2);
}
.fm.on { background: #fff; color: var(--ink); box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }

/* 主卡（原型：margin-top:26px; padding:28px 16px; 居中） */
.focus-card {
  margin-top: 52rpx;
  padding: 56rpx 32rpx;
  background: var(--card);
  border-radius: 36rpx;
  box-shadow: var(--shadow);
  text-align: center;
}

/* 宠物角落小图（原型 pet-in-corner：56px 居中）+ 轻浮动 */
.focus-stage { text-align: center; }
.pet-corner {
  width: 112rpx; height: 112rpx;
  margin: 0 auto 12rpx;
  display: block;
  animation: pet-float 1.4s ease-in-out infinite alternate;
}
@keyframes pet-float {
  from { transform: translateY(0); }
  to { transform: translateY(-12rpx); }
}
.timer-sub { font-size: 26rpx; color: var(--ink-2); min-height: 40rpx; line-height: 1.5; }

/* 计时器 */
.timer {
  font-family: var(--serif);
  font-size: 120rpx; font-weight: 800; letter-spacing: 4rpx;
  text-align: center; margin: 24rpx 0 8rpx;
  font-variant-numeric: tabular-nums; color: var(--ink);
}
.timer.running { color: var(--accent-d); }

.btn-primary.big { width: 100%; padding: 30rpx 0; font-size: 32rpx; margin-top: 32rpx; }
.fast { margin-top: 20rpx; font-size: 26rpx; }

/* 底部安抚文案（原型 focus-hint：透明卡、弱化文字） */
.focus-hint {
  margin-top: 36rpx;
  padding: 0 24rpx;
  font-size: 25rpx;
  color: var(--ink-3);
  line-height: 1.7;
  text-align: center;
}
