/* pages/mine/mine.wxss */
.page { padding: 32rpx 28rpx 80rpx; }

.bond {
  background: var(--card); border-radius: 28rpx; padding: 40rpx 28rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.05);
}
.bond-ava {
  width: 128rpx; height: 128rpx; border-radius: 36rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 72rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}
.bond-name { font-size: 30rpx; font-weight: 700; margin-top: 18rpx; }
.bond-stats { display: flex; width: 100%; margin-top: 28rpx; }
.b-item { flex: 1; text-align: center; position: relative; }
.b-item::after { content:''; position:absolute; right:0; top:10rpx; bottom:10rpx; width:1rpx; background:#eee; }
.b-item:last-child::after { display:none; }
.b-num { display:block; font-size: 44rpx; font-weight: 800; color: var(--brand); }
.b-lbl { font-size: 22rpx; color: var(--ink-soft); margin-top: 4rpx; }

.block-title { font-size: 28rpx; color: var(--ink-soft); margin: 36rpx 6rpx 16rpx; }

.cal {
  background: var(--card); border-radius: 24rpx; padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.cal-week { display: flex; }
.cal-week text { flex: 1; text-align: center; font-size: 22rpx; color: var(--ink-soft); padding: 8rpx 0; }
.cal-grid { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.cal-cell {
  width: 14.28%; height: 92rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; position: relative;
}
.cal-cell.empty { visibility: hidden; }
.cal-day { font-size: 24rpx; color: var(--ink); }
.cal-paw {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; margin-top: 4rpx;
}
.cal-cell.milestone .cal-paw { box-shadow: 0 0 0 4rpx #ffd54f; }
.cal-legend { font-size: 22rpx; color: var(--ink-soft); text-align: center; margin-top: 12rpx; }

.mem-list { display: flex; flex-direction: column; gap: 14rpx; }
.mem {
  background: var(--card); border-radius: 18rpx; padding: 22rpx 24rpx;
  display: flex; gap: 20rpx; align-items: flex-start;
  box-shadow: 0 3rpx 12rpx rgba(0,0,0,0.03);
}
.mem.ms { border-left: 6rpx solid #ffd54f; background: rgba(255,213,79,0.08); }
.mem-date { font-size: 22rpx; color: var(--ink-soft); flex-shrink: 0; width: 132rpx; }
.mem-text { font-size: 26rpx; line-height: 1.5; }
.empty { text-align: center; color: var(--ink-soft); font-size: 26rpx; padding: 50rpx 0; }

.set { background: var(--card); border-radius: 24rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.set-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 30rpx 26rpx; border-bottom: 1rpx solid #f0f0f0;
}
.set-row:last-child { border-bottom: none; }
.set-row text { font-size: 28rpx; }
.set-val { font-size: 26rpx; color: var(--brand); }

.share-btn { margin-top: 40rpx; }

.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45);
  display: flex; align-items: center; justify-content: center; z-index: 100;
}
.modal { background: #fff; width: 78%; border-radius: 28rpx; padding: 40rpx; }
.modal-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.share-card {
  border-radius: 20rpx; padding: 40rpx 30rpx; margin-bottom: 18rpx;
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
}
.share-card.dark { color: #fff; }
.share-card.light { background: #fff7f0; color: var(--ink); border: 2rpx solid var(--brand-soft); }
.sc-emoji { font-size: 80rpx; }
.sc-text { font-size: 26rpx; text-align: center; line-height: 1.6; }
.btn-ghost { margin-top: 14rpx; background: #f0f0f0; color: var(--ink); border-radius: 999rpx; font-size: 28rpx; }
