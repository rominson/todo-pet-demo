/* pages/mine/mine.wxss —— 档案页 */
.page { padding: 24rpx 28rpx 80rpx; }

.bond { display: flex; flex-direction: column; align-items: center; padding: 44rpx 28rpx 36rpx; }
.bond-img { width: 200rpx; height: 170rpx; }
.bond-name { font-size: 30rpx; font-weight: 600; margin-top: 12rpx; }
.bond-stats { display: flex; width: 100%; margin-top: 28rpx; border-top: 2rpx solid var(--track); padding-top: 24rpx; }
.b-item { flex: 1; text-align: center; display: flex; flex-direction: column; }
.b-num { font-size: 40rpx; font-weight: 700; color: var(--ink); }
.b-lbl { font-size: 24rpx; color: var(--ink-2); margin-top: 4rpx; }

.mem-card { padding: 28rpx 32rpx; }
.mem-list { display: flex; flex-direction: column; }
.mem { display: flex; gap: 20rpx; padding: 16rpx 0; border-bottom: 2rpx solid var(--track); }
.mem:last-child { border-bottom: none; }
.mem-date { color: var(--ink-2); font-size: 24rpx; flex-shrink: 0; padding-top: 2rpx; }
.mem-text { font-size: 26rpx; color: var(--ink); flex: 1; }
.mem.ms .mem-text { color: var(--accent); font-weight: 600; }
.empty { text-align: center; color: var(--ink-3); padding: 40rpx 0; font-size: 26rpx; }

.set { padding: 8rpx 32rpx; }
.set-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 26rpx 0; border-bottom: 2rpx solid var(--track); font-size: 28rpx;
}
.set-row:last-child { border-bottom: none; }
.set-val { color: var(--ink-2); }

.share-btn { margin-top: 44rpx; }
