<!-- pages/mine/mine.wxml —— 宠物档案（1:1 对齐原型 sheet-profile）
     原型结构：看书动画头像 → 名字 → 一句话 → 陪伴天数/一起完成/专注小时 → 纪念日 → 回忆册
     原型里没有「设置」（我的生日 / 重要节点提醒），也没有分享按钮，故不在此页出现。 -->
<view class="page" style="padding-top:{{pageTop}}px">

  <!-- 左上角返回（原先右上角的叉会被微信胶囊按钮挡住，改到左上角） -->
  <view class="topbar" style="padding-top:{{statusBarHeight}}px">
    <view class="nav-back" bindtap="goBack"><view class="chev"></view></view>
  </view>

  <!-- 头像：对应当前宠物的「看书」动图（原型 renderPets：#pet-profile-avatar 用 SCENES[cur].read） -->
  <view class="prof-head">
    <view class="prof-avatar">
      <image class="prof-video" src="{{petErr ? petFallback : petAnim}}" mode="aspectFit" binderror="onPetErr" />
    </view>
    <view class="prof-name">{{pet.name}}</view>
    <view class="prof-desc">你的 AI 智能伙伴 —— 它记得你完成过的每件事</view>
  </view>

  <view class="stat-row">
    <view class="stat-box"><view class="n">{{companionDays}}</view><view class="l">陪伴天数</view></view>
    <view class="stat-box"><view class="n">{{doneTotal}}</view><view class="l">一起完成</view></view>
    <view class="stat-box"><view class="n">{{focusHours}}</view><view class="l">专注小时</view></view>
  </view>

  <view class="group-title">纪念日</view>
  <view class="card anv-card">
    <view wx:for="{{annivs}}" wx:key="day" class="anv">
      <view class="anv-ico {{item.passed?'ok':'wait'}}"></view>
      <view class="anv-txt">{{item.label}} {{item.tail}}</view>
    </view>
  </view>

  <view class="group-title">回忆册</view>
  <view class="card mem-card">
    <view class="mem-list">
      <view wx:for="{{memories}}" wx:key="id" class="mem {{item.milestone?'ms':''}}">
        <text class="mem-date">{{item.date}}</text>
        <text class="mem-text">{{item.content}}</text>
      </view>
      <view wx:if="{{memories.length===0}}" class="empty">还没有回忆，去完成一件待办或专注一次吧</view>
    </view>
  </view>
</view>
