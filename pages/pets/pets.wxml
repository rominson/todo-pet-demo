<!-- pages/pets/pets.wxml —— 星座伙伴（对齐原型 screen-store：横向滑动大卡片轮播 + 底部全家桶悬浮条） -->
<view class="page {{showBundle?'has-bundle':''}}">
  <!-- 首行：左侧分组标题，右上角是「订单」入口（订单中心页 pages/orders/orders 的站内入口）。
       放在这一页的右上角而不是档案页：档案页要滚过「纪念日 + 回忆册」才看得到，回忆一多更沉；
       这里首屏就在，且遇见页本身就是消费发生的页面。
       注：微信胶囊（··· ⊙）常驻导航栏右上角，所以入口落在页面内容区的右上角（标题同一行）。 -->
  <view class="toprow">
    <view class="group-title">星座伙伴</view>
    <view class="orders-entry" hover-class="orders-entry-hover" hover-stay-time="80" bindtap="goOrders">
      <view class="oe-ico"></view>
      <text class="oe-txt">订单</text>
    </view>
  </view>

  <!-- 顶部白卡横幅：只承担「价格 + 收集进度」的说明。
       集齐 12 只后整块隐藏（对齐原型 renderStore：ownedCount===12 时 display:none）——
       都拥有了，这行「已拥有 12/12」和价目表就没有信息量了。 -->
  <view wx:if="{{showBanner}}" class="store-banner card">
    <view class="sb-text">
      <view class="t">12 个星座伙伴</view>
      <view class="s">单个 ¥{{singlePrice}} 买断 · 全家桶 12 个 ¥{{bundleTotal}}</view>
    </view>
    <view class="store-progress {{ownedCount>=12?'done':''}}">已拥有 {{ownedCount}}/12</view>
  </view>

  <scroll-view scroll-x class="store-grid" enhanced show-scrollbar="{{false}}"
               scroll-with-animation bindscroll="onTrackScroll" scroll-left="{{scrollLeft}}">
    <view class="store-track">
      <view wx:for="{{pets}}" wx:key="key"
            class="animal-card {{item.owned?'owned':''}} {{item.isCurrent?'is-active':''}}">
        <view wx:if="{{!item.owned}}" class="lock-ico">🔒</view>
        <view wx:if="{{item.owned}}" class="owned-badge">已拥有</view>
        <view class="a-emoji">
          <image class="a-img" src="{{item.scene}}" mode="aspectFit" />
        </view>
        <view class="a-meta">
          <view class="a-name">{{item.animal}}</view>
          <view class="a-zodiac">{{item.zodiacName}} · {{item.traits}}</view>
          <!-- 卡片唯一的操作入口（详情弹层已删除：弹层里只有大图+名字+星座·两个词，卡片上全都有，纯属多一步）
               未拥有→直接唤起支付 / 已拥有→直接切为当前伙伴 / 陪伴中→灰掉不可点 -->
          <view class="a-pill {{item.isCurrent?'is-disabled':''}}"
                hover-class="{{item.isCurrent?'none':'a-pill-hover'}}" hover-stay-time="80"
                catchtap="onPill" data-key="{{item.key}}">{{item.pillText}}</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 轮播圆点指示器（对齐原型 meet-dots） -->
  <view class="meet-dots">
    <view wx:for="{{pets}}" wx:key="key"
          class="dot {{index===activeIdx?'on':''}}"
          catchtap="goDot" data-idx="{{index}}"></view>
  </view>

  <!-- 全家桶悬浮条（对齐原型 #bundle-btn：左下角是「当前要补的差价」，右侧「购买」，整条可点）。
       只在遇见页且还没集齐时显示；已付满封顶价 ¥36 时不再收钱，文案换成「免费领」。 -->
  <view wx:if="{{showBundle}}" class="bundle-cta"
        hover-class="bundle-cta-hover" hover-stay-time="80"
        bindtap="doBuyBundle">
    <view class="bc-main">
      <view class="bc-t">{{bundleTitle}}</view>
      <view class="bc-s">{{bundleSub}}</view>
    </view>
    <view class="bc-buy">{{bundleBuy}}</view>
  </view>
</view>
