<!-- pages/pets/pets.wxml —— 星座伙伴（对齐原型 screen-store：横向滑动大卡片轮播） -->
<view class="page">
  <view class="group-title">星座伙伴</view>

  <view class="store-banner card">
    <view class="sb-text">
      <view class="t">12 个星座伙伴</view>
      <view class="s">单个 ¥6 解锁</view>
    </view>
    <view class="store-progress {{ownedCount>=12?'done':''}}">已拥有 {{ownedCount}}/12</view>
  </view>

  <scroll-view scroll-x class="store-grid" enhanced show-scrollbar="{{false}}"
               scroll-with-animation bindscroll="onTrackScroll" scroll-left="{{scrollLeft}}">
    <view class="store-track">
      <view wx:for="{{pets}}" wx:key="key"
            class="animal-card {{item.owned?'owned':''}} {{item.isCurrent?'is-active':''}}">
        <view wx:if="{{!item.owned}}" class="lock-ico">🔒</view>
        <view wx:if="{{item.owned}}" class="owned-badge">已拥有</view>
        <view class="a-emoji">
          <image class="a-img" src="{{item.scene}}" mode="aspectFit" />
        </view>
        <view class="a-meta">
          <view class="a-name">{{item.animal}}</view>
          <view class="a-zodiac">{{item.zodiacName}} · {{item.traits}}</view>
          <!-- 本页唯一的操作入口（已删除详情弹层：弹层里只有大图+名字+星座·两个词，卡片上全都有，纯属多一步）
               未拥有→直接唤起支付 / 已拥有→直接切为当前伙伴 / 陪伴中→灰掉不可点 -->
          <view class="a-pill {{item.isCurrent?'is-disabled':''}}"
                hover-class="{{item.isCurrent?'none':'a-pill-hover'}}" hover-stay-time="80"
                catchtap="onPill" data-key="{{item.key}}">{{item.pillText}}</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 轮播圆点指示器（对齐原型 meet-dots） -->
  <view class="meet-dots">
    <view wx:for="{{pets}}" wx:key="key"
          class="dot {{index===activeIdx?'on':''}}"
          catchtap="goDot" data-idx="{{index}}"></view>
  </view>
</view>
