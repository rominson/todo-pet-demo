/* pages/pets/pets.wxss */
.page { padding: 32rpx 28rpx 60rpx; }

.hero {
  display: flex; flex-direction: column; align-items: center;
  padding: 40rpx 0 32rpx;
}
.hero-ava {
  width: 140rpx; height: 140rpx; border-radius: 40rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 80rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}
.hero-name { font-size: 32rpx; font-weight: 700; margin-top: 20rpx; }
.hero-sub { font-size: 24rpx; color: var(--ink-soft); margin-top: 6rpx; }

.birth-tip {
  background: var(--brand-soft); color: var(--brand);
  font-size: 24rpx; padding: 18rpx 24rpx; border-radius: 16rpx;
  margin-bottom: 24rpx; text-align: center;
}

.grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.pet-cell {
  position: relative;
  width: calc((100% - 40rpx) / 3);
  background: var(--card); border-radius: 24rpx;
  padding: 28rpx 0 22rpx; text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border: 3rpx solid transparent;
}
.pet-cell.owned { border-color: rgba(255,138,61,0.3); }
.pet-cell.active { border-color: var(--brand); box-shadow: 0 6rpx 20rpx rgba(255,138,61,0.2); }
.pet-cell.isbirth { border-color: #ffd54f; }
.cell-ava {
  width: 96rpx; height: 96rpx; border-radius: 28rpx; margin: 0 auto;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx;
}
.cell-name { font-size: 26rpx; font-weight: 600; margin-top: 14rpx; }
.cell-tag {
  display: inline-block; margin-top: 10rpx;
  font-size: 20rpx; color: var(--ink-soft);
  background: #f2f2f2; padding: 2rpx 14rpx; border-radius: 999rpx;
}
.cell-tag.free { color: var(--brand); background: var(--brand-soft); }
.cell-tag.price { color: #fff; background: var(--brand); }
.birth-flag {
  position: absolute; top: 0; left: 0;
  background: #ffd54f; color: #6b4e00;
  font-size: 18rpx; padding: 2rpx 12rpx;
  border-radius: 24rpx 0 16rpx 0;
}

.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center; z-index: 100;
}
.modal {
  background: #fff; width: 78%; border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx; text-align: center;
}
.d-ava {
  width: 150rpx; height: 150rpx; border-radius: 40rpx; margin: 0 auto;
  display: flex; align-items: center; justify-content: center; font-size: 88rpx;
}
.d-name { font-size: 34rpx; font-weight: 700; margin-top: 22rpx; }
.d-desc { font-size: 26rpx; color: var(--ink-soft); margin: 18rpx 0 30rpx; line-height: 1.6; }
.btn-ghost { margin-top: 14rpx; background: #f0f0f0; color: var(--ink); border-radius: 999rpx; font-size: 28rpx; }
