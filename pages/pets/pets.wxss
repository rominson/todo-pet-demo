/* pages/pets/pets.wxss —— 对齐原型 screen-store：横向滑动大卡片轮播 */
.page { padding: 28rpx 0 80rpx; box-sizing: border-box; }

.group-title { font-size: 30rpx; font-weight: 700; color: var(--ink-2); margin: 8rpx 36rpx 16rpx; }

/* 顶部白卡横幅 */
.store-banner { margin: 0 36rpx 20rpx; padding: 28rpx 32rpx; display: flex; align-items: center; }
.sb-text .t { font-family: var(--serif); font-size: 32rpx; font-weight: 800; color: var(--ink); line-height: 1.4; }
.sb-text .s { font-size: 24rpx; color: var(--ink-2); margin-top: 6rpx; }

/* 横向滚动卡片 */
.store-grid {
  display: flex;
  white-space: nowrap;
  scroll-snap-type: x mandatory;
  gap: 28rpx;
  padding: 28rpx 72rpx 60rpx;
  box-sizing: border-box;
}
.animal-card {
  flex: 0 0 74%;
  max-width: 560rpx;
  height: 720rpx;
  scroll-snap-align: center;
  background: #fff;
  border-radius: 52rpx;
  box-shadow: 0 8rpx 20rpx rgba(40, 30, 20, 0.10);
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.animal-card.is-active { box-shadow: 0 16rpx 34rpx rgba(126, 111, 214, 0.22); }

.lock-ico {
  position: absolute; top: 22rpx; right: 22rpx; z-index: 3;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.7); color: var(--ink-2);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx;
}

.a-emoji {
  flex: 1;
  position: relative;
  display: flex; align-items: flex-end; justify-content: center;
  padding: 0 36rpx 32rpx;
  background: radial-gradient(120% 82% at 50% 10%, rgba(255, 255, 255, 0.92) 0%, rgba(246, 244, 239, 0.6) 70%);
}
.a-emoji::after {
  content: ''; position: absolute; left: 50%; bottom: 28rpx; transform: translateX(-50%);
  width: 54%; height: 14rpx; background: rgba(40, 30, 20, 0.16); border-radius: 50%; filter: blur(7px); z-index: 0;
}
.a-img { position: relative; z-index: 1; width: auto; height: 86%; max-width: 92%; object-fit: contain; filter: drop-shadow(0 6rpx 12rpx rgba(0,0,0,.10)); }

.a-meta { position: relative; padding: 28rpx 32rpx 32rpx; background: #fff; }
.a-name { font-family: var(--serif); font-size: 42rpx; font-weight: 800; color: var(--ink); line-height: 1.15; }
.a-zodiac { font-size: 24rpx; color: var(--ink-2); margin-top: 6rpx; }
.a-price {
  display: inline-block; margin-top: 20rpx; font-size: 24rpx; font-weight: 700;
  color: #3A2E10; background: var(--gold); padding: 12rpx 28rpx; border-radius: 999rpx;
}

/* 详情弹层 */
.modal .grab { width: 80rpx; height: 8rpx; border-radius: 4rpx; background: var(--line); margin: 0 auto 28rpx; }
.d-img { width: 280rpx; height: 280rpx; display: block; margin: 0 auto 24rpx; }
.d-name { font-family: var(--serif); font-size: 44rpx; font-weight: 800; color: var(--ink); text-align: center; }
.d-zodiac { font-size: 26rpx; color: var(--ink-2); text-align: center; margin: 8rpx 0 32rpx; }
.d-current { text-align: center; color: var(--ink-3); font-size: 28rpx; padding: 24rpx 0; }
