/* pages/pets/pets.wxss —— 遇见页 */
.page { padding: 24rpx 28rpx 60rpx; }
.title { font-family: var(--serif); font-size: 44rpx; font-weight: 600; margin: 8rpx 8rpx 24rpx; }

.hero { display: flex; flex-direction: column; align-items: center; padding: 40rpx 32rpx 36rpx; }
.hero-img { width: 220rpx; height: 190rpx; }
.hero-name { font-size: 32rpx; font-weight: 700; margin-top: 16rpx; }
.hero-sub { font-size: 24rpx; color: var(--ink-2); margin-top: 6rpx; }

.birth-tip {
  background: var(--accent-soft); color: var(--accent);
  font-size: 24rpx; padding: 18rpx 24rpx; border-radius: 20rpx;
  margin: 24rpx 0; text-align: center;
}

.grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.pet-cell {
  position: relative;
  width: calc((100% - 40rpx) / 3);
  box-sizing: border-box;
  background: var(--card); border-radius: 32rpx;
  padding: 20rpx 16rpx 22rpx; text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(58, 46, 16, 0.05);
  border: 3rpx solid transparent;
}
.pet-cell.owned { border-color: rgba(126, 111, 214, 0.35); }
.pet-cell.active { border-color: var(--accent); box-shadow: 0 8rpx 24rpx rgba(126, 111, 214, 0.25); }
.pet-cell.isbirth { border-color: #e8b54c; }
.cell-img { width: 110rpx; height: 96rpx; }
.cell-name { font-size: 26rpx; font-weight: 600; margin-top: 10rpx; }
.cell-tag {
  display: inline-block; margin-top: 8rpx;
  font-size: 20rpx; color: var(--ink-2);
  background: var(--bg); padding: 2rpx 14rpx; border-radius: 999rpx;
}
.cell-tag.free { color: var(--accent); background: var(--accent-soft); }
.cell-tag.price { color: #fff; background: var(--accent); }
.birth-flag {
  position: absolute; top: 0; left: 0;
  background: #e8b54c; color: #6b4e00;
  font-size: 18rpx; padding: 2rpx 12rpx;
  border-radius: 24rpx 0 16rpx 0;
}

.modal-mask {
  position: fixed; inset: 0; background: rgba(58, 46, 16, 0.4);
  display: flex; align-items: center; justify-content: center; z-index: 100;
}
.modal {
  background: var(--bg-soft); width: 78%; border-radius: 40rpx;
  padding: 48rpx 40rpx 36rpx; text-align: center;
}
.d-img { width: 100%; height: 400rpx; border-radius: 24rpx; }
.d-name { font-size: 34rpx; font-weight: 700; margin-top: 16rpx; }
.d-desc { font-size: 26rpx; color: var(--ink-2); margin: 18rpx 0 30rpx; line-height: 1.6; }
.btn-ghost { margin-top: 14rpx; background: transparent; color: var(--ink-2); border-radius: 999rpx; font-size: 28rpx; border: 2rpx solid var(--ink-3); }
