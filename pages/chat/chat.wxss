.chat { display: flex; flex-direction: column; height: 100vh; padding: 0; }
.msgs { flex: 1; padding: 24rpx; }
.msg { display: flex; margin-bottom: 20rpx; }
.msg.me { justify-content: flex-end; }
.bubble { max-width: 70%; padding: 20rpx 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.msg.me .bubble { background: var(--brand); color: #fff; }
.input-bar { display: flex; gap: 16rpx; padding: 16rpx 24rpx; border-top: 1rpx solid #eee; background: #fff; }
.input { flex: 1; background: #f3f3f3; border-radius: 999rpx; padding: 16rpx 24rpx; }
.send { width: 140rpx; padding: 16rpx 0; }
