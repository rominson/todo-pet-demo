<!-- pages/quadrant/quadrant.wxml —— 四象限 -->
<view class="page">
  <view class="head">
    <view class="title">四象限</view>
    <view class="filters">
      <view class="chip {{filter==='all'?'on':''}}" bindtap="setFilter" data-f="all">全部</view>
      <view class="chip {{filter==='undone'?'on':''}}" bindtap="setFilter" data-f="undone">未完成</view>
    </view>
  </view>
  <view class="total">{{total}} 项</view>

  <view class="grid">
    <view wx:for="{{quads}}" wx:key="key" class="quad {{item.key}}">
      <view class="q-head">
        <view class="q-title">{{item.title}}</view>
        <view class="q-sub">{{item.sub}} · {{item.items.length}}</view>
      </view>
      <view wx:for="{{item.items}}" wx:for-item="t" wx:key="_id"
            class="q-task {{t.done?'done':''}}" bindtap="onItem" data-id="{{t._id}}">
        <view class="q-task-title">{{t.title}}</view>
        <view class="q-task-meta">
          <text wx:if="{{t.due}}" class="q-due">{{t.due}}</text>
          <text wx:if="{{t.overdue}}" class="q-flag overdue">已过期</text>
          <text wx:if="{{t.done}}" class="q-flag done">已完成</text>
        </view>
      </view>
      <view wx:if="{{item.items.length===0}}" class="q-empty">空</view>
    </view>
  </view>
</view>

<!-- 悬浮新建按钮（与今日页一致） -->
<view class="fab" bindtap="showAdd">＋</view>

<!-- 新建任务弹层 -->
<view wx:if="{{showAdd}}" class="modal-mask" bindtap="hideAdd">
  <view class="modal" catchtap="noop">
    <view class="modal-title">新建任务</view>
    <view class="modal-sub">一件事，做完打勾就好</view>
    <input class="input" placeholder="任务名称" value="{{form.title}}" bindinput="onTitle" />
    <input class="input" placeholder="标签（可选）" value="{{form.tag}}" bindinput="onTag" />
    <picker mode="date" value="{{form.due}}" bindchange="onDue">
      <view class="input picker">{{form.due || '提醒日期（可选）'}} ›</view>
    </picker>
    <view class="opt-row">
      <view class="opt-lbl">
        <view>标为重要</view>
        <view class="opt-sub">会进四象限「重要」区</view>
      </view>
      <switch checked="{{form.important}}" bindchange="onImportant" color="#7e6fd6" />
    </view>
    <view class="type-row">
      <view class="type-opt {{form.type==='normal'?'on':''}}" bindtap="setType" data-t="normal">勾选完成</view>
      <view class="type-opt {{form.type==='focus'?'on':''}}" bindtap="setType" data-t="focus">计时专注</view>
    </view>
    <button class="btn-primary" bindtap="onCreate">添加任务</button>
    <button class="btn-ghost" bindtap="hideAdd">取消</button>
  </view>
</view>
