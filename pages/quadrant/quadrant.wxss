/* pages/quadrant/quadrant.wxss */
.page { padding: 24rpx 28rpx 60rpx; }
.head { display: flex; justify-content: space-between; align-items: center; }
.title { font-family: var(--serif); font-size: 44rpx; font-weight: 600; }
.filters { display: flex; gap: 14rpx; }
.chip {
  font-size: 24rpx;
  color: var(--ink-2);
  background: var(--card);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}
.chip.on { background: var(--accent); color: #fff; }
.total { color: var(--ink-2); font-size: 24rpx; margin: 12rpx 8rpx 20rpx; }

.grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.quad {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: var(--card);
  border-radius: 36rpx;
  padding: 26rpx;
  min-height: 280rpx;
}
.quad.iu { background: var(--accent-soft); }
.quad.iu .q-title { color: var(--accent); }
.q-title { font-size: 28rpx; font-weight: 600; }
.q-sub { font-size: 22rpx; color: var(--ink-2); margin-top: 4rpx; }
.q-task {
  background: var(--bg-soft);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}
.q-task.done .q-task-title { color: var(--ink-3); text-decoration: line-through; }
.q-task-title { font-size: 26rpx; word-break: break-all; }
.q-task-meta { display: flex; gap: 12rpx; margin-top: 6rpx; }
.q-due { font-size: 20rpx; color: var(--ink-2); }
.q-flag { font-size: 20rpx; border-radius: 6rpx; padding: 0 8rpx; }
.q-flag.overdue { color: #fff; background: var(--warm); }
.q-flag.done { color: var(--ok); background: rgba(127, 183, 126, 0.15); }
.q-empty { color: var(--ink-3); font-size: 24rpx; text-align: center; margin-top: 60rpx; }
