/* pages/quadrant/quadrant.wxss —— 四象限
   卡片/行样式对齐原型 .quad-cell / .quad-task：白卡 + 顶部彩色描边 + 虚线分隔的行，
   行首一个小圆圈（点掉即完成），左滑露出「删除」。 */
/* 四张卡片撑满标题以下的剩余高度（对齐原型 .quad-grid 的 grid-template-rows:1fr 1fr 四等分）：
   .page 锁死在视口里、变成 flex 列 → .grid 吃掉剩余空间 → 上下两行再平分 → 四卡一样大。
   卡片内部任务多了在 .q-list 里自己滚，页面本身不滚（原型 .quad-list{flex:1;overflow-y:auto}）。
   底部留出的是自定义 tabBar 的高度（它 fixed 覆盖在页面上）。 */
.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx calc(176rpx + env(safe-area-inset-bottom));
}
.head { display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }
.title { font-family: var(--serif); font-size: 44rpx; font-weight: 600; }
.filters { display: flex; gap: 14rpx; }
.chip {
  font-size: 24rpx;
  color: var(--ink-2);
  background: var(--card);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}
.chip.on { background: var(--accent); color: #fff; }
.total { color: var(--ink-2); font-size: 24rpx; margin: 12rpx 8rpx 20rpx; flex-shrink: 0; }

.grid {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  /* 关键两点：align-content 让上下两行平分容器高度；align-items 让同一行两张卡等高。
     原来只写了 display:flex;flex-wrap，卡片高度各随内容，于是四张大小不一。 */
  align-content: stretch;
  align-items: stretch;
}
.quad {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: var(--card);
  border-radius: 31rpx;
  border-top: 6rpx solid var(--quad-c, #C9C2B6);
  padding: 25rpx 25rpx 17rpx;
  box-shadow: var(--shadow);
  /* 卡内自成滚动容器：标题固定，任务列表滚动（原来有 min-height:280rpx，会撑破自由拉伸） */
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}
.quad.iu { --quad-c: #E4695B; }
.quad.in { --quad-c: var(--accent); }
.quad.nu { --quad-c: #5B8DEF; }
.quad.nn { --quad-c: #B9B3A8; }

.q-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12rpx; flex-shrink: 0; }
.q-titles { min-width: 0; }
.q-title { font-size: 26rpx; font-weight: 800; color: var(--ink); }
.q-sub { font-size: 20rpx; color: var(--ink-2); margin-top: 4rpx; }
.q-count {
  font-size: 20rpx;
  color: var(--ink-3);
  background: #F1EDE4;
  border-radius: 999rpx;
  padding: 4rpx 15rpx;
  font-weight: 800;
  flex-shrink: 0;
}

/* 任务列表：吃掉卡片剩余高度，超出时只有这一块滚（原型 .quad-list{flex:1;min-height:0;overflow-y:auto}） */
.q-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
}

/* 左滑：外层裁剪，内层让位给「删除」。象限卡片窄，按钮收窄一些。 */
.q-list .task-swipe { border-bottom: 2rpx dashed rgba(0, 0, 0, 0.06); }
.q-list .task-swipe:last-child { border-bottom: none; }
.quad .swipe-btn { width: 116rpx; font-size: 24rpx; }
.quad .task-swipe.open .q-task { transform: translateX(-116rpx); }

.q-task {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  padding: 15rpx 0;
  background: var(--card);
  position: relative;
  z-index: 2;
  transition: transform .25s ease;
}
.q-task.done { opacity: .55; }
.q-task.future { opacity: .75; }
.q-task.overdue .qt { color: #E4695B; }

/* 行首圆圈：点一下即完成（对齐原型 .qdot） */
.qdot {
  width: 29rpx;
  height: 29rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(0, 0, 0, 0.18);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  position: relative;
  z-index: 2;
  transition: background .2s, border-color .2s;
}
.qdot.on { background: var(--ok); border-color: var(--ok); }
.qdot .tick { width: 15rpx; height: 8rpx; border-left-width: 3rpx; border-bottom-width: 3rpx; margin-top: -3rpx; }
.qdot.on .tick { opacity: 1; }
.q-task.future .qdot { opacity: .45; }

.q-body { flex: 1; min-width: 0; }
.qt { font-size: 25rpx; color: var(--ink); word-break: break-word; line-height: 1.35; }
.q-task.done .qt { color: var(--ink-3); text-decoration: line-through; }

.qt-t {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}
.qt-tag { border-radius: 8rpx; padding: 0 10rpx; }
.qt-tag.repeat { color: var(--accent-d); background: var(--accent-soft); }
.qt-tag.overdue { color: #fff; background: var(--warm); }
.qt-tag.done { color: var(--ok); background: rgba(127, 183, 126, 0.15); }
.imp-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}
.q-empty { font-size: 23rpx; color: var(--ink-3); text-align: center; padding: 19rpx 0 15rpx; }

/* 悬浮新建按钮（与今日页一致） */
.fab {
  position: fixed;
  right: 44rpx;
  /* 自定义 tabBar 固定盖在底部（100rpx + 安全区），悬浮按钮要落在它上面 */
  bottom: 160rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(126, 111, 214, 0.4);
  z-index: 50;
}

/* 新建弹层补充样式（mask/modal/input/btn 在 app.wxss 公共） */
.modal-sub { text-align: center; color: var(--ink-2); font-size: 24rpx; margin-top: -16rpx; margin-bottom: 24rpx; }
.picker { color: var(--ink); }
.opt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
}
.opt-lbl { font-size: 28rpx; }
.opt-sub { font-size: 22rpx; color: var(--ink-2); margin-top: 2rpx; }
