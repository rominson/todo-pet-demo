<!-- pages/index/index.wxml —— 首页：宠物陪伴 + 待办清单 -->
<view class="page">
  <!-- 宠物陪伴区 -->
  <view class="pet-card">
    <view class="pet-ava" style="background:{{pet.color}}">{{pet.emoji}}</view>
    <view class="pet-meta">
      <view class="pet-name">{{pet.name}}</view>
      <view class="pet-sub">一直在这儿陪着你</view>
    </view>
    <view wx:if="{{greeting}}" class="pet-bubble">“{{greeting}}”</view>
  </view>

  <!-- 统计 -->
  <view class="stats">
    <view class="stat">
      <view class="num">{{doneTotal}}</view>
      <view class="lbl">一起搞定</view>
    </view>
    <view class="stat">
      <view class="num">{{streak}}</view>
      <view class="lbl">连续天数</view>
    </view>
    <view class="stat">
      <view class="num">{{companionDays}}</view>
      <view class="lbl">陪伴天数</view>
    </view>
  </view>

  <!-- 待办 -->
  <view class="section-title">今天的事</view>
  <view class="task-list">
    <view wx:for="{{tasks}}" wx:key="_id" class="task {{item.done?'done':''}}">
      <view class="check {{item.done?'on':''}}" catchtap="onToggle" data-id="{{item._id}}">{{item.done?'✓':''}}</view>
      <view class="task-body" catchtap="onToggle" data-id="{{item._id}}">
        <view class="task-title">{{item.title}}</view>
        <view wx:if="{{item.tag || item.due}}" class="task-tags">
          <text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text>
          <text wx:if="{{item.due}}" class="due">📅 {{item.due}}</text>
        </view>
      </view>
      <view wx:if="{{item.type==='focus' && !item.done}}" class="focus-badge" catchtap="goFocus" data-id="{{item._id}}">专注</view>
      <view class="del" catchtap="onRemove" data-id="{{item._id}}">✕</view>
    </view>
    <view wx:if="{{tasks.length===0}}" class="empty">还没有待办，点下面的 ＋ 加一件吧</view>
  </view>

  <view class="add-bar" bindtap="showAdd">＋ 加一件待办</view>
</view>

<!-- 完成/陪伴气泡 -->
<view wx:if="{{bubble}}" class="float-bubble">{{bubble}}</view>

<!-- 新增弹层 -->
<view wx:if="{{showAdd}}" class="modal-mask" bindtap="hideAdd">
  <view class="modal" catchtap="noop">
    <view class="modal-title">新待办</view>
    <input class="fld" placeholder="要做什么？" value="{{form.title}}" bindinput="onTitle" />
    <input class="fld" placeholder="标签（可选）" value="{{form.tag}}" bindinput="onTag" />
    <input class="fld" placeholder="截止日期 如 2026-09-20（可选）" value="{{form.due}}" bindinput="onDue" />
    <view class="type-row">
      <view class="type-opt {{form.type==='normal'?'on':''}}" bindtap="setType" data-t="normal">勾选完成</view>
      <view class="type-opt {{form.type==='focus'?'on':''}}" bindtap="setType" data-t="focus">计时专注</view>
    </view>
    <button class="btn-primary" bindtap="onCreate">添加</button>
    <button class="btn-ghost" bindtap="hideAdd">取消</button>
  </view>
</view>
