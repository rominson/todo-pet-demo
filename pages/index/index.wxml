<!-- pages/index/index.wxml —— 今日：问候 + 宠物陪伴 + 进度 + 待办 -->
<view class="page" bindtap="hideArchive">
  <!-- 主卡：问候 / 宠物 / 进度 / 统计（对齐原型 companion-card） -->
  <view class="card hero face-{{petFace}}">
    <view class="gear" bindtap="goProfile">⚙︎</view>
    <view class="greet-block">
      <view class="greet">{{greetWord}}</view>
      <view class="date">{{todayText}}</view>
    </view>
    <view class="pet-card">
      <view class="pet-clip" catchtap="toggleArchive">
        <image class="pet-img" style="{{petStyle}}" src="{{petErr ? pet.read : (pet.anim || pet.read)}}" mode="aspectFit" binderror="onPetErr" />
      </view>
      <view wx:if="{{greeting}}" class="pet-bubble {{petFace==='left'?'bl':'br'}}">{{greeting}}</view>
      <view class="pet-archive-pop {{archiveShow?'show':''}}" catchtap="openArchive">档案</view>
    </view>

    <view class="progress-row">
      <text class="progress-lbl">今日进度</text>
      <text class="progress-num">{{progress}}%</text>
    </view>
    <view class="bar">
      <view class="bar-fill" style="width:{{progress}}%"></view>
    </view>

    <view class="stats">
      <view class="stat">
        <view class="num">{{doneTotal}}</view>
        <view class="lbl">一起完成</view>
      </view>
      <view class="stat">
        <view class="num">{{companionDays}}</view>
        <view class="lbl">陪伴天数</view>
      </view>
      <view class="stat">
        <view class="num">{{focusMinutes}}</view>
        <view class="lbl">专注分钟</view>
      </view>
    </view>
  </view>

  <!-- 待办卡 -->
  <view class="card list-card">
    <view class="list-head">今天 · {{doneToday}}/{{totalToday}} 完成</view>
    <view class="task-list">
      <view wx:for="{{tasks}}" wx:key="_id"
            class="task-swipe {{openId===item._id?'open':''}} {{item._fly?'fly':''}}"
            style="{{item._st}}"
            data-id="{{item._id}}"
            bindtouchstart="onSwipeStart" bindtouchmove="onSwipeMove" bindtouchend="onSwipeEnd">
        <view class="swipe-btn del" catchtap="onRemove" data-id="{{item._id}}">删除</view>
        <view class="task-item {{item.done?'done':''}}">
          <view class="check {{item.done?'on':''}}" catchtap="onToggle" data-id="{{item._id}}"><view class="tick"></view></view>
          <view class="task-body" catchtap="onToggle" data-id="{{item._id}}">
            <view class="task-title">
              <text wx:if="{{item.important}}" class="imp-dot"></text>
              {{item.title}}
            </view>
            <view wx:if="{{item.repeatLabel || item.due}}" class="task-tags">
              <text wx:if="{{item.repeatLabel}}" class="tag repeat">🔁 {{item.repeatLabel}}</text>
              <text wx:if="{{item.due}}" class="due">📅 {{item.due}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{tasks.length===0}}" class="empty">一件事，做完打勾就好</view>
    </view>
  </view>
</view>

<!-- 悬浮新建按钮 -->
<view class="fab" bindtap="showAdd">＋</view>

<!-- 完成/陪伴气泡 -->
<view wx:if="{{bubble}}" class="float-bubble">{{bubble}}</view>

<!-- 新建任务弹层 -->
<view wx:if="{{showAdd}}" class="modal-mask" bindtap="hideAdd">
  <view class="modal" catchtap="noop">
    <view class="sheet-x" bindtap="hideAdd">✕</view>
    <view class="modal-title">新建任务</view>
    <view class="modal-sub">一件事，做完打勾就好</view>
    <input class="input" placeholder="任务名称" value="{{form.title}}" bindinput="onTitle" />
    <picker mode="date" value="{{form.due}}" bindchange="onDue">
      <view class="input picker">{{form.due || '提醒日期（可选）'}} ›</view>
    </picker>
    <view class="opt-row">
      <view class="opt-lbl">
        <view>标为重要</view>
        <view class="opt-sub">会进四象限「重要」区</view>
      </view>
      <switch checked="{{form.important}}" bindchange="onImportant" color="#7e6fd6" />
    </view>
    <view class="opt-row">
      <view class="opt-lbl">
        <view>重复</view>
        <view class="opt-sub">完成后自动生成下一条</view>
      </view>
      <switch checked="{{form.repeatOn}}" bindchange="onRepeat" color="#7e6fd6" />
    </view>
    <block wx:if="{{form.repeatOn}}">
      <view class="freq-row">
        <view wx:for="{{freqs}}" wx:key="f"
              class="freq-opt {{form.freq===item.f?'on':''}}"
              bindtap="pickFreq" data-f="{{item.f}}">{{item.t}}</view>
      </view>
      <view wx:if="{{form.freq==='custom'}}" class="custom-row">
        <text class="custom-lbl">每</text>
        <input class="custom-num" type="number" value="{{form.customNum}}" bindinput="onCustomNum" />
        <picker mode="selector" range="{{units}}" range-key="t" value="{{form.unitIdx}}" bindchange="onCustomUnit">
          <view class="custom-unit">{{units[form.unitIdx].t}} ›</view>
        </picker>
      </view>
    </block>
    <button class="btn-primary" bindtap="onCreate">添加任务</button>
  </view>
</view>
