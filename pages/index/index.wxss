.page { padding: 24rpx; }
.hero { margin-bottom: 24rpx; }
.hero-pet { font-size: 36rpx; font-weight: 700; }
.broadcast { margin-top: 8rpx; }
.section-title { margin: 24rpx 8rpx 12rpx; font-weight: 600; }
.todo-item { padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.todo-item:last-child { border-bottom: none; }
.quick { display: flex; gap: 16rpx; margin-top: 32rpx; }
.quick-btn { flex: 1; text-align: center; background: var(--card); border-radius: 20rpx; padding: 24rpx 0; box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.04); }
