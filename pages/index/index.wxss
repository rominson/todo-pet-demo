/* pages/index/index.wxss —— 今日页（对齐原型米白+紫） */
.page { padding: 24rpx 28rpx 200rpx; }

/* 主卡 */
.hero { position: relative; }
.gear {
  margin: 0 4rpx 12rpx auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: var(--shadow);
  color: var(--ink-2);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 问候块：face-right 时右对齐，face-left 时左对齐（对齐原型 card-greeting） */
.greet-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  text-align: right;
  gap: 12rpx;
  margin: 4rpx 8rpx 12rpx 0;
}
.hero.face-left .greet-block { align-items: flex-start; text-align: left; margin: 4rpx 0 12rpx 8rpx; }
.greet {
  font-family: var(--serif);
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ink);
  line-height: 1.1;
}
.date { color: var(--ink-2); font-size: 26rpx; line-height: 1.1; }

/* 宠物卡：整块高度固定，宠物尽量贴住卡片边缘，另一侧留给对话气泡。
   用左右负 margin 抵掉卡片的 40rpx 内边距，让宠物能真正贴到卡片边。 */
.pet-card {
  position: relative;
  height: 330rpx;
  padding: 0;
  margin: 16rpx -40rpx 20rpx;
}
/* 裁剪盒：宠物大图外扩出的白边在这里被裁掉，
   否则溢出到米白色页底会露出一块白（背景色不一致的旧问题）。 */
.pet-clip {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  overflow: hidden;
}
/* 宠物展示位：原型运行时是 280×170 的大动画（pet-video-wrap 实测值），
   不是 CSS 里那个 88px 小 stage——大图才有 HTML 原型的视觉比例。 */
.pet-img {
  position: absolute;
  top: 0;
  width: 540rpx;
  height: 330rpx;
  z-index: 1;
}
/* 具体贴左还是贴右、推多少，由 utils/pets.js 的 petEdgeStyle 按素材白边算出（内联 style） */
/* 今日页宠物用真·动图素材（APNG 转的 GIF 循环播放）。 */

/* 「档案」小按钮落点：浮在宠物头部那一侧
   （脸朝右→宠物贴左，按钮在宠物右侧；脸朝左→宠物贴右，按钮在左侧） */
.hero.face-right .pet-archive-pop { left: 300rpx; }
.hero.face-left .pet-archive-pop { right: 300rpx; }

/* 对话气泡：宠物在左时气泡在右（br），宠物在右时气泡在左（bl） */
.pet-bubble {
  position: absolute;
  top: 50%;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 16rpx 22rpx;
  font-size: 25rpx;
  color: var(--ink);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.07);
  line-height: 1.5;
  z-index: 6;
  max-width: 420rpx;
}
.pet-bubble.br {
  left: auto;
  right: 40rpx;
  max-width: 350rpx;
  transform: translateY(-50%);
}
.pet-bubble.br::after {
  content: '';
  position: absolute;
  left: -13rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-right: 14rpx solid #fff;
}
.pet-bubble.bl {
  left: 40rpx;
  max-width: 350rpx;
  transform: translateY(-50%);
}
.pet-bubble.bl::after {
  content: '';
  position: absolute;
  right: -13rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 14rpx solid #fff;
}

/* 进度 */
.progress-row { display: flex; justify-content: space-between; margin-top: 32rpx; }
.progress-lbl { color: var(--ink-2); font-size: 26rpx; }
.progress-num { color: var(--ink); font-size: 26rpx; font-weight: 600; }
.bar { height: 14rpx; background: var(--track); border-radius: 999rpx; margin-top: 12rpx; overflow: hidden; }
.bar-fill { height: 100%; background: var(--accent); border-radius: 999rpx; transition: width 0.3s; }

/* 统计 */
.stats { display: flex; margin-top: 36rpx; border-top: 2rpx solid var(--track); padding-top: 28rpx; }
.stat { flex: 1; text-align: center; }
.num { font-size: 44rpx; font-weight: 700; color: var(--ink); }
.lbl { color: var(--ink-2); font-size: 24rpx; margin-top: 4rpx; }

/* 待办卡 */
.list-card { margin-top: 28rpx; }
.list-head { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.task-list { display: flex; flex-direction: column; }
/* 待办行：外层 .task-swipe 负责裁剪，内层 .task-item 左滑让位给「删除」
   （原型待办没有右侧的叉，是左滑出删除） */
.task-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--track);
  background: var(--card);
  position: relative;
  z-index: 2;
  transition: transform .25s ease;
}
.task-swipe.open .task-item { transform: translateX(-160rpx); }
.task-swipe:last-child .task-item { border-bottom: none; }
.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background .2s, border-color .2s;
}
.check.on { background: var(--ok); border-color: var(--ok); }
.task-body { flex: 1; margin: 0 20rpx; min-width: 0; }
.task-title { font-size: 30rpx; color: var(--ink); word-break: break-all; }
.task-item.done .task-title { color: var(--ink-3); text-decoration: line-through; }
.task-item.done { opacity: .55; }
.imp-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
  margin-right: 10rpx;
  vertical-align: middle;
}
.task-tags { display: flex; gap: 12rpx; margin-top: 8rpx; }
.tag {
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.due { font-size: 22rpx; color: var(--ink-2); }
.empty { text-align: center; color: var(--ink-3); padding: 60rpx 0; }

/* 悬浮新建按钮 */
.fab {
  position: fixed;
  right: 44rpx;
  /* 自定义 tabBar 固定盖在底部（100rpx + 安全区），悬浮按钮要落在它上面 */
  bottom: 160rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(126, 111, 214, 0.4);
  z-index: 50;
}

/* 气泡 */
.float-bubble {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 200rpx;
  max-width: 80%;
  background: rgba(58, 46, 16, 0.85);
  color: #fff;
  font-size: 26rpx;
  padding: 18rpx 30rpx;
  border-radius: 999rpx;
  z-index: 60;
}

/* 弹层 */
.modal-sub { text-align: center; color: var(--ink-2); font-size: 24rpx; margin-top: -16rpx; margin-bottom: 24rpx; }
.picker { color: var(--ink); }
.opt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
}
.opt-lbl { font-size: 28rpx; }
.opt-sub { font-size: 22rpx; color: var(--ink-2); margin-top: 2rpx; }
/* 任务上的重复标记（对齐原型 .tag.repeat） */
.tag.repeat { background: var(--accent-soft); color: var(--accent); }
