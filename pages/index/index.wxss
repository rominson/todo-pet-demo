/* pages/index/index.wxss —— 今日页（对齐原型米白+紫） */
.page { padding: 24rpx 28rpx 200rpx; }

/* 主卡 */
.hero { position: relative; }
.gear {
  margin: 0 4rpx 12rpx auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: var(--shadow);
  color: var(--ink-2);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 问候块：face-right 时右对齐，face-left 时左对齐（对齐原型 card-greeting） */
.greet-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  text-align: right;
  gap: 12rpx;
  margin: 4rpx 8rpx 12rpx 0;
}
.hero.face-left .greet-block { align-items: flex-start; text-align: left; margin: 4rpx 0 12rpx 8rpx; }
.greet {
  font-family: var(--serif);
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ink);
  line-height: 1.1;
}
.date { color: var(--ink-2); font-size: 26rpx; line-height: 1.1; }

/* 宠物卡：按脸朝向决定左右（原型 pet-card.face-right/left） */
.pet-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  margin: 16rpx 0 20rpx;
}
.hero.face-right .pet-card { justify-content: flex-start; }
.hero.face-left .pet-card { justify-content: flex-end; }
.pet-stage {
  width: 176rpx;
  height: 200rpx;
  padding-top: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}
.pet-img {
  width: 168rpx;
  height: 168rpx;
  position: relative;
  z-index: 1;
  animation: pet-float 1.4s ease-in-out infinite alternate;
}
@keyframes pet-float {
  from { transform: translateY(0); }
  to { transform: translateY(-16rpx); }
}

/* 对话气泡：宠物在左时气泡在右（br），宠物在右时气泡在左（bl） */
.pet-bubble {
  position: absolute;
  top: 50%;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 16rpx 22rpx;
  font-size: 25rpx;
  color: var(--ink);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.07);
  line-height: 1.5;
  z-index: 6;
  max-width: 420rpx;
}
.pet-bubble.br {
  left: 192rpx;
  transform: translateY(-50%);
}
.pet-bubble.br::after {
  content: '';
  position: absolute;
  left: -13rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-right: 14rpx solid #fff;
}
.pet-bubble.bl {
  left: 16rpx;
  max-width: 300rpx;
  transform: translateY(-50%);
}
.pet-bubble.bl::after {
  content: '';
  position: absolute;
  right: -13rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 14rpx solid #fff;
}

/* 进度 */
.progress-row { display: flex; justify-content: space-between; margin-top: 32rpx; }
.progress-lbl { color: var(--ink-2); font-size: 26rpx; }
.progress-num { color: var(--ink); font-size: 26rpx; font-weight: 600; }
.bar { height: 14rpx; background: var(--track); border-radius: 999rpx; margin-top: 12rpx; overflow: hidden; }
.bar-fill { height: 100%; background: var(--accent); border-radius: 999rpx; transition: width 0.3s; }

/* 统计 */
.stats { display: flex; margin-top: 36rpx; border-top: 2rpx solid var(--track); padding-top: 28rpx; }
.stat { flex: 1; text-align: center; }
.num { font-size: 44rpx; font-weight: 700; color: var(--ink); }
.lbl { color: var(--ink-2); font-size: 24rpx; margin-top: 4rpx; }

/* 待办卡 */
.list-card { margin-top: 28rpx; }
.list-head { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.task-list { display: flex; flex-direction: column; }
.task {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--track);
}
.task:last-child { border-bottom: none; }
.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--ink-3);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.check.on { background: var(--accent); border-color: var(--accent); }
.task-body { flex: 1; margin: 0 20rpx; min-width: 0; }
.task-title { font-size: 30rpx; color: var(--ink); word-break: break-all; }
.task.done .task-title { color: var(--ink-3); text-decoration: line-through; }
.imp-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
  margin-right: 10rpx;
  vertical-align: middle;
}
.task-tags { display: flex; gap: 12rpx; margin-top: 8rpx; }
.tag {
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.due { font-size: 22rpx; color: var(--ink-2); }
.focus-badge {
  font-size: 22rpx;
  color: var(--accent);
  border: 2rpx solid var(--accent);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  flex-shrink: 0;
}
.del { color: var(--ink-3); font-size: 28rpx; padding: 8rpx 0 8rpx 20rpx; flex-shrink: 0; }
.empty { text-align: center; color: var(--ink-3); padding: 60rpx 0; }

/* 悬浮新建按钮 */
.fab {
  position: fixed;
  right: 44rpx;
  bottom: 60rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(126, 111, 214, 0.4);
  z-index: 50;
}

/* 气泡 */
.float-bubble {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 200rpx;
  max-width: 80%;
  background: rgba(58, 46, 16, 0.85);
  color: #fff;
  font-size: 26rpx;
  padding: 18rpx 30rpx;
  border-radius: 999rpx;
  z-index: 60;
}

/* 弹层 */
.modal-sub { text-align: center; color: var(--ink-2); font-size: 24rpx; margin-top: -16rpx; margin-bottom: 24rpx; }
.picker { color: var(--ink); }
.opt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
}
.opt-lbl { font-size: 28rpx; }
.opt-sub { font-size: 22rpx; color: var(--ink-2); margin-top: 2rpx; }
.type-row { display: flex; gap: 20rpx; margin-bottom: 28rpx; }
.type-opt {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: var(--card);
  color: var(--ink-2);
  font-size: 26rpx;
}
.type-opt.on { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
